<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishAot>true</PublishAot>
        <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
        <AWSProjectType>Lambda</AWSProjectType>
        <!-- This property makes the build directory similar to a publish directory and helps the AWS .NET Lambda Mock Test Tool find project dependencies. -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <!-- Generate ready to run images during publishing to improve cold start time. -->
        <PublishReadyToRun>true</PublishReadyToRun>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Amazon.Lambda.Annotations" Version="2.2.0" />
        <PackageReference Include="Amazon.Lambda.CloudWatchEvents" Version="5.0.0" />
        <PackageReference Include="Amazon.Lambda.Core" Version="3.1.1" />
        <PackageReference Include="Amazon.Lambda.Serialization.SystemTextJson" Version="2.4.5"/>
        <PackageReference Include="AWSSDK.Billing" Version="4.0.100.2" />
        <PackageReference Include="AWSSDK.CloudWatch" Version="4.0.101.2" />
        <PackageReference Include="AWSSDK.CloudWatchEvents" Version="4.0.100.2" />
        <PackageReference Include="AWSSDK.ControlTower" Version="4.0.100.2" />
        <PackageReference Include="AWSSDK.Organizations" Version="4.0.100.3" />
        <PackageReference Include="AWSSDK.RAM" Version="4.0.100.2" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0-preview.4.26230.115" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="CAV.BillingView.Tests" />
    </ItemGroup>
</Project>